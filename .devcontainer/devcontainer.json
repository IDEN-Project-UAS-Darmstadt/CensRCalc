{
  "name": "CensRCalc R Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "nano,cmake,libuv1-dev,libx11-dev"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/rocker-org/devcontainer-features/pandoc:1": {},
    "ghcr.io/rocker-org/devcontainer-features/r-rig:1": {
      "version": "release",
      "vscodeRSupport": true,
      "installDevTools": true
    },
    "ghcr.io/rocker-org/devcontainer-features/r-packages:1": {
      "packages": "languageserver,remotes,httpgd,DT"
    },
    "ghcr.io/rocker-org/devcontainer-features/r-dependent-packages:0": {},
    "ghcr.io/rocker-org/devcontainer-features/r-history:0": {},
    "ghcr.io/devcontainers/features/python:1": {
      "installTools": true,
      "toolsToInstall": "pre-commit"
    }
  },
  "postCreateCommand": [
    "sh",
    "-c",
    "echo 'if(file.exists(\"~/.vscode-R/init.R\")) source(\"~/.vscode-R/init.R\")' > ~/.Rprofile && Rscript -e 'tinytex::install_tinytex()' && echo 'export PATH=\"$HOME/bin:$PATH\"' >> ~/.bashrc"
  ],
  "postStartCommand": [
    "sh",
    "-c",
    "export PATH=\"$HOME/bin:$PATH\" && tlmgr install makeindex"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "r.plot.useHttpgd": true
      },
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "REditorSupport.r",
        "GitHub.vscode-github-actions",
        "DavidAnson.vscode-markdownlint"
      ]
    }
  }
}